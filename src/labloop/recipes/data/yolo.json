{
  "id": "yolo",
  "description": "Ultralytics YOLO 训练（示例配方）。命令里的 {run_id} 保证每次实验写入独立目录。",
  "command": "yolo train data={data} model={model} epochs={epochs} batch={batch} imgsz={imgsz} seed={seed} project={project} name=labloop-{run_id}",
  "parameters": {
    "batch": {
      "description": "批大小（研究变量）",
      "values": ["8", "16", "32", "64"]
    }
  },
  "fixed": {
    "data": "coco128.yaml",
    "model": "yolov8n.pt",
    "epochs": "50",
    "imgsz": "640",
    "seed": "42",
    "project": "runs"
  },
  "metrics": [
    {
      "name": "mAP50",
      "kind": "csv_last",
      "file": "{project}/labloop-{run_id}/results.csv",
      "column": "metrics/mAP50(B)"
    },
    {
      "name": "mAP50-95",
      "kind": "csv_last",
      "file": "{project}/labloop-{run_id}/results.csv",
      "column": "metrics/mAP50-95(B)"
    }
  ],
  "timeout_s": 3600
}
