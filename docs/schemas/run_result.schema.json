      "title": "RunStatus",
      "type": "string"
    }
  },
  "properties": {
    "duration_s": {
      "title": "Duration S",
      "type": "number"
    },
    "ended_at": {
      "title": "Ended At",
      "type": "string"
    },
    "env": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
