            {
              "$ref": "#/$defs/GpuSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "packages_hash": {
          "title": "Packages Hash",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "python": {
          "title": "Python",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "python",
        "packages_hash"
      ],
      "title": "EnvRecord",
      "type": "object"
    },
    "GpuSummary": {
      "properties": {
        "driver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "GpuSummary",
      "type": "object"
    },
    "Note": {
