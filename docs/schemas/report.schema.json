        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "fixed": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Fixed",
          "type": "object"
        },
        "log_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Path"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Params",
          "type": "object"
        },
        "recipe_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe Id"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Note"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "status",
        "started_at",
        "ended_at",
        "duration_s"
      ],
      "title": "RunResult",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "ok",
        "failed",
        "timeout",
        "interrupted"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ToolInfo": {
      "properties": {
        "name": {
          "default": "labloop",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "ToolInfo",
      "type": "object"
    }
