  "properties": {
    "best_overall": {
      "anyOf": [
        {
          "$ref": "#/$defs/BestPoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "rounds": {
      "items": {
        "$ref": "#/$defs/ReportRound"
      },
      "title": "Rounds",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stopped_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stopped Reason"
    },
    "study_slug": {
      "title": "Study Slug",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/ToolInfo"
    }
  },
  "required": [
    "tool",
    "study_slug",
    "question",
    "generated_at"
  ],
  "title": "Report",
  "type": "object"
}
